# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
*.spec
# ...except this project's own. The blanket rule above is inherited from a
# sibling project where PyInstaller generates the spec into build\, making it an
# artifact. Here packaging\net-preset.spec is hand-written source and belongs in
# the repository. Without this exception a new spec is invisible to git status:
# the committed one survives only because git exempts files it already tracks,
# and that exemption does not extend to the next one.
!packaging/*.spec

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
# The report .github\workflows\build.yml asks pytest for, so that the workflow
# can read which tests skipped instead of parsing a summary line. It lands in
# the working tree of anyone who runs that command to reproduce a red run.
junit.xml

# Agent working directories. These hold specifications, implementation plans and
# task reports: a record of how the program was built, not the program itself,
# and they carry absolute local paths. Excluded from the first commit onwards,
# because removing them later would mean rewriting history.
.superpowers/
docs/

# Local configuration and anything secret
.env
.env.*
*.local
secrets.*

# Editors
.vscode/
.idea/
*.swp

# OS
Thumbs.db
desktop.ini
$RECYCLE.BIN/
